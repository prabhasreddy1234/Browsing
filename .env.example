# Copy this file to .env and fill in the keys you have. Nothing here is required
# to boot the app — Jev and the LLM each run in clearly-badged simulation mode
# when their key is missing.

# Jev (TypeSafe System One) — https://typesafe.ai
# Powers every "Jev" decision. Typed choices, input-billed only ($0.042/1M), output free.
TYPESAFE_API_KEY=

# LLM that "writes the words" (tool baseline + browser answer summary)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Jev pricing + demo spend cap (optional overrides)
JEV_IN_PER_M=0.042
DEMO_BUDGET_USD=0.5
